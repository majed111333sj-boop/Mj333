{
  "name": "smart-diag",
  "version": "2.0.0",
  "private": true,
  "description": "الفاحص الذكي - تشخيص أعطال السيارات والأسعار العادلة والورش والوكلاء",
  "scripts": {
    "build": "tailwindcss -i ./input.css -o ./dist/style.css --minify && node -e \"const fs=require('fs');fs.readdirSync('.').filter(f=>f.endsWith('.html')).forEach(f=>fs.copyFileSync(f,'dist/'+f))\"",
    "dev": "tailwindcss -i ./input.css -o ./dist/style.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
